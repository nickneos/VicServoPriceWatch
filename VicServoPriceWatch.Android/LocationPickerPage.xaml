<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="VicServoPriceWatch.Android.LocationPickerPage"
             Title="Select location">

    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <maps:Map
            x:Name="LocationMap"
            Grid.Row="0"
            MapType="Street"
            IsShowingUser="True"
            MapClicked="OnMapClicked" />

        <VerticalStackLayout
            Grid.Row="1"
            Padding="16"
            Spacing="10"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}">
            <Label
                x:Name="SelectionStatusLabel"
                Text="Tap the map to select a location."
                SemanticProperties.HeadingLevel="Level2" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry
                    Grid.Column="0"
                    x:Name="AddressSearchEntry"
                    Placeholder="Search suburb or postcode"
                    TextChanged="OnAddressSearchTextChanged"
                    HorizontalOptions="Fill" />

                <Button
                    Grid.Column="1"
                    Text="Cancel"
                    Clicked="OnCancelClicked" />
            </Grid>

            <CollectionView
                x:Name="AddressSuggestionsView"
                HeightRequest="180"
                IsVisible="False"
                SelectionMode="Single"
                SelectionChanged="OnAddressSuggestionSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Padding="12,8"
                            Text="{Binding .}"
                            FontSize="16" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                x:Name="ConfirmButton"
                Text="Use selected location"
                Clicked="OnConfirmClicked"
                IsEnabled="False"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
