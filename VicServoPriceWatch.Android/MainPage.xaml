<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VicServoPriceWatch.Android.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="Vic Servo Price Watch"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                x:Name="LocationStatusLabel"
                Text="Location has not been requested."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                x:Name="LocationButton"
                Text="Use my location"
                SemanticProperties.Hint="Requests permission and gets the current device location"
                Clicked="OnGetLocationClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="FindServosButton"
                Text="Find nearby servos"
                SemanticProperties.Hint="Gets fuel prices for the nearest service stations"
                Clicked="OnFindServosClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="ResultsLabel"
                Text="Nearby servo results will appear here."
                SemanticProperties.HeadingLevel="Level2" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
